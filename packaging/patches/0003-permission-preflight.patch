+/// Check both privacy permissions without prompting or opening a device.
+pub fn ikanata_permission_status() -> i32 {
+    // SAFETY: both system functions take only scalar arguments or no arguments.
+    let permissions = unsafe {
+        (
+            AXIsProcessTrusted(),
+            IOHIDCheckAccess(K_IOHID_REQUEST_TYPE_LISTEN_EVENT) == K_IOHID_ACCESS_TYPE_GRANTED,
+        )
+    };
+    match permissions {
+        (true, true) => 0,
+        (false, true) => 10,
+        (true, false) => 11,
+        (false, false) => 12,
+    }
+}
 
