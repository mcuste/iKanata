 use std::time::Duration;
 
 impl Kanata {
     pub fn start_ikanata_shutdown(kanata: Arc<Mutex<Self>>) {
         std::thread::spawn(move || {
+            let mut paused = false;
             while !crate::oskbd::ikanata_shutdown_requested() {
+                let now_paused = crate::oskbd::IKANATA_ROOT_PAUSED.load(std::sync::atomic::Ordering::Acquire);
+                if now_paused && !paused {
+                    kanata.lock().kbd_out.ikanata_release_output();
+                }
+                paused = now_paused;
                 std::thread::sleep(Duration::from_millis(10));
