diff --git a/src/oskbd/ikanata_session.rs b/src/oskbd/ikanata_session.rs
new file mode 100644
--- /dev/null
+++ b/src/oskbd/ikanata_session.rs
@@ -0,0 +1,108 @@
+use super::{CFBoolean, CFDictionary, CFString, CFStringRef, CFType, TCFType, dict_bool};
+use core_foundation::array::CFArray;
+use core_foundation::base::CFAllocatorRef;
+use core_foundation::dictionary::CFMutableDictionaryRef;
+use core_foundation::number::CFNumber;
+use std::sync::OnceLock;
+
+#[link(name = "IOKit", kind = "framework")]
+unsafe extern "C" {
+    fn IORegistryGetRootEntry(port: u32) -> u32;
+    fn IORegistryEntryCreateCFProperties(
+        entry: u32,
+        properties: *mut CFMutableDictionaryRef,
+        allocator: CFAllocatorRef,
+        options: u32,
+    ) -> i32;
+    fn IOObjectRelease(object: u32) -> i32;
+}
+
+#[link(name = "SystemConfiguration", kind = "framework")]
+unsafe extern "C" {
+    fn SCDynamicStoreCopyConsoleUser(
+        store: *const std::ffi::c_void,
+        uid: *mut u32,
+        gid: *mut u32,
+    ) -> CFStringRef;
+}
+
+pub(super) fn active() -> Option<bool> {
+    static OWNER: OnceLock<Option<u32>> = OnceLock::new();
+    let owner = (*OWNER.get_or_init(|| {
+        std::env::var("IKANATA_OWNER_UID")
+            .ok()?
+            .parse::<u32>()
+            .ok()
+            .filter(|uid| *uid != 0)
+    }))?;
+    // SAFETY: the default IOKit port is zero and returns an owned registry entry.
+    let root = unsafe { IORegistryGetRootEntry(0) };
+    if root == 0 {
+        return None;
+    }
+    let mut properties = std::ptr::null_mut();
+    // SAFETY: properties is writable and root remains owned until IOObjectRelease.
+    let status = unsafe {
+        let status = IORegistryEntryCreateCFProperties(root, &mut properties, std::ptr::null(), 0);
+        IOObjectRelease(root);
+        status
+    };
+    if properties.is_null() {
+        return None;
+    }
+    // SAFETY: IOKit returns a retained dictionary of Core Foundation property values.
+    let registry: CFDictionary<CFString, CFType> = unsafe {
+        CFDictionary::wrap_under_create_rule(properties.cast_const())
+    };
+    if status != 0 {
+        return None;
+    }
+    let mut locked = dict_bool(&registry, "IOConsoleLocked")?;
+    let sessions = registry.find(&CFString::from_static_string("IOConsoleUsers"))?;
+    if !sessions.instance_of::<CFArray>() {
+        return None;
+    }
+    // SAFETY: the array type was checked and registry properties contain CFType values.
+    let sessions: CFArray<CFType> = unsafe {
+        CFArray::wrap_under_get_rule(sessions.as_CFTypeRef().cast())
+    };
+    let (mut uid, mut gid) = (0, 0);
+    // SAFETY: the default store is null and both output UID/GID pointers are writable.
+    let name = unsafe { SCDynamicStoreCopyConsoleUser(std::ptr::null(), &mut uid, &mut gid) };
+    if name.is_null() {
+        return None;
+    }
+    // SAFETY: SCDynamicStoreCopyConsoleUser returns an owned string when nonnull.
+    let name = unsafe { CFString::wrap_under_create_rule(name) };
+    if uid != owner || name == CFString::from_static_string("loginwindow") {
+        return Some(false);
+    }
+    let mut active = false;
+    for value in sessions.iter() {
+        if !value.instance_of::<CFDictionary>() {
+            return None;
+        }
+        // SAFETY: the dictionary type was checked and session entries contain CFType values.
+        let session: CFDictionary<CFString, CFType> = unsafe {
+            CFDictionary::wrap_under_get_rule(value.as_CFTypeRef().cast())
+        };
+        let uid = session
+            .find(&CFString::from_static_string("kCGSSessionUserIDKey"))?
+            .downcast::<CFNumber>()?
+            .to_i64()?;
+        let uid = u32::try_from(uid).ok()?;
+        let on_console = dict_bool(&session, "kCGSSessionOnConsoleKey")?;
+        let logged_in = dict_bool(&session, "kCGSessionLoginDoneKey")?;
+        if !on_console {
+            continue;
+        }
+        if active || uid != owner || !logged_in {
+            return Some(false);
+        }
+        if let Some(value) = session.find(&CFString::from_static_string("CGSSessionScreenIsLocked")) {
+            locked |= value.downcast::<CFBoolean>().map(bool::from)?;
+        }
+        active = true;
+    }
+    Some(active && !locked)
+}
