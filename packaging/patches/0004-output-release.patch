 use std::sync::atomic::{AtomicBool, Ordering};
 use std::sync::mpsc::SyncSender as Sender;
 use std::time::{Duration, Instant};
+
+static IKANATA_SHUTDOWN: AtomicBool = AtomicBool::new(false);
+static IKANATA_EXIT_CODE: std::sync::atomic::AtomicI32 = std::sync::atomic::AtomicI32::new(0);
+
+extern "C" fn ikanata_sigterm(_signal: libc::c_int) {
+    IKANATA_SHUTDOWN.store(true, Ordering::SeqCst);
+}
+
+pub fn install_ikanata_shutdown_handler() -> io::Result<()> {
+    // SAFETY: the handler only stores a lock-free atomic flag.
+    if unsafe { libc::signal(libc::SIGTERM, ikanata_sigterm as *const () as libc::sighandler_t) } == libc::SIG_ERR {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(())
+}
+
+pub fn request_ikanata_shutdown(code: i32) {
+    IKANATA_EXIT_CODE.store(code, Ordering::SeqCst);
+    IKANATA_SHUTDOWN.store(true, Ordering::SeqCst);
+}
+
+pub fn ikanata_shutdown_requested() -> bool {
+    IKANATA_SHUTDOWN.load(Ordering::SeqCst)
+}
+
+pub fn finish_ikanata_shutdown() -> ! {
+    // SAFETY: _exit avoids the DriverKit static destructor race.
+    unsafe { libc::_exit(IKANATA_EXIT_CODE.load(Ordering::SeqCst)) }
+}
 
