 use std::time::Duration;
 
 impl Kanata {
+    pub fn start_ikanata_shutdown(kanata: Arc<Mutex<Self>>) {
+        std::thread::spawn(move || {
+            while !crate::oskbd::ikanata_shutdown_requested() {
+                std::thread::sleep(Duration::from_millis(10));
+            }
+            let mut state = kanata.lock();
+            state.kbd_out.ikanata_release_output();
+            // Prevent new output while the driver processes queued release reports.
+            std::thread::sleep(Duration::from_millis(100));
+            crate::oskbd::finish_ikanata_shutdown();
+        });
+    }
+
