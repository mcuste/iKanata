+#[cfg(all(feature = "tcp_server", target_os = "macos"))]
+fn local_listener() -> std::os::unix::net::UnixListener {
+    use std::os::unix::fs::{FileTypeExt, MetadataExt, PermissionsExt};
+    use std::os::unix::net::{UnixListener, UnixStream};
+    const DIRECTORY: &str = "/Library/Application Support/iKanata";
+    const SOCKET: &str = "/Library/Application Support/iKanata/control.sock";
+    let directory = std::fs::symlink_metadata(DIRECTORY).expect("private control directory exists");
+    assert!(directory.is_dir() && directory.uid() == 0 && directory.mode() & 0o7777 == 0o700,
+        "control directory must be root-owned with mode 0700");
+    match std::fs::symlink_metadata(SOCKET) {
+        Ok(metadata) => {
+            assert!(metadata.file_type().is_socket() && metadata.uid() == 0,
+                "existing control path must be a root-owned socket");
+            match UnixStream::connect(SOCKET) {
+                Ok(_) => panic!("another engine owns the control socket"),
+                Err(error) if error.kind() == std::io::ErrorKind::ConnectionRefused => {
+                    std::fs::remove_file(SOCKET).expect("remove stale control socket");
+                }
+                Err(error) => panic!("cannot inspect control socket: {error}"),
+            }
+        }
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+        Err(error) => panic!("cannot inspect control path: {error}"),
+    }
+    let listener = UnixListener::bind(SOCKET).expect("local control server starts");
+    std::fs::set_permissions(SOCKET, std::fs::Permissions::from_mode(0o600))
+        .expect("restrict local control socket");
+    listener
+}
