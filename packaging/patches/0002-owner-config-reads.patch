diff --git a/parser/src/cfg/ikanata_reader.rs b/parser/src/cfg/ikanata_reader.rs
new file mode 100644
--- /dev/null
+++ b/parser/src/cfg/ikanata_reader.rs
@@ -0,0 +1,32 @@
+use std::path::Path;
+
+pub(super) fn read_config_file(path: &Path) -> std::io::Result<String> {
+    #[cfg(target_os = "macos")]
+    {
+        unsafe extern "C" {
+            fn geteuid() -> u32;
+        }
+        // SAFETY: geteuid has no arguments or memory requirements.
+        if unsafe { geteuid() } == 0 {
+            use std::io::{Error, ErrorKind};
+            use std::process::{Command, Stdio};
+            let owner = std::env::var("IKANATA_OWNER_UID")
+                .ok().and_then(|value| value.parse::<u32>().ok())
+                .filter(|uid| *uid != 0)
+                .ok_or_else(|| Error::new(ErrorKind::PermissionDenied, "configuration owner required"))?;
+            let output = Command::new("/Library/PrivilegedHelperTools/iKanata/ikanata-config-reader")
+                .env_clear()
+                .arg(owner.to_string())
+                .arg(path)
+                .stdin(Stdio::null())
+                .stderr(Stdio::null())
+                .output()?;
+            if !output.status.success() {
+                return Err(Error::new(ErrorKind::PermissionDenied, "configuration cannot be read as its owner"));
+            }
+            return String::from_utf8(output.stdout)
+                .map_err(|_| Error::new(ErrorKind::InvalidData, "configuration is not UTF-8"));
+        }
+    }
+    std::fs::read_to_string(path)
+}
